IBKR_DATABASE=

IBKR_BASE_URL=
IBKR_CONSUMER_KEY=
IBKR_REALM=

# Authentication with OAUTH: Use IBKR's this site
# https://ndcdyn.interactivebrokers.com/sso/Login?action=OAUTH&RL=1&ip2loc=US
# More explanation on https://github.com/Voyz/ibind/wiki/OAuth-1.0a
IBKR_ACCESS_TOKEN=
IBKR_ACCESS_TOKEN_SECRET=
IBKR_SIGNATURE_KEY_PATH=
IBKR_ENCRYPTION_KEY_PATH=
IBKR_DH_PARAM_PATH=
IBKR_TIMEOUT_SECONDS=

# Optional defaults used only by the interactive quick-vwap-order utility.
IBKR_ACCOUNT_ID=
IBKR_QUICK_ORDER_PREFIX=quick-vwap

# Optional path to a JSON file with base order-confirmation answers.
# Missing or empty paths are treated as {}, and --answers-json overrides duplicate keys.
IBKR_ORDERS_ANSWER_JSON=./order_answers.example.json

# Cache setup
IBKR_LST_CACHE_MODE=
IBKR_REDIS_URL=
IBKR_REDIS_KEY_PREFIX=
IBKR_LST_REFRESH_SKEW_SECONDS=
IBKR_LST_LOCK_TTL_SECONDS=
